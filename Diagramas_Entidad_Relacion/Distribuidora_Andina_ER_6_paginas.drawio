dx="1800" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4-background" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;connectable=0;movable=0;editable=0;resizable=0;deletable=0;" parent="1" vertex="1"><mxGeometry x="0" y="0" width="1800" height="1250" as="geometry" /></mxCell><mxCell id="p4-title" value="Abastecimiento" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#253B61;" parent="1" vertex="1"><mxGeometry x="70" y="34" width="1650" height="44" as="geometry" /></mxCell><mxCell id="p4-subtitle" value="Base de datos: Abastecimiento | Distribuidora Andina S.A.S." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=17;fontColor=#536984;" parent="1" vertex="1"><mxGeometry x="70" y="82" width="1650" height="34" as="geometry" /></mxCell><mxCell id="p4-footer" value="Cada microservicio tiene persistencia independiente. Los identificadores de otros servicios son referencias lógicas validadas por sus APIs; no son claves foráneas SQL entre bases de datos." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F2F6FC;strokeColor=#D7E2F0;fontFamily=Arial;fontSize=15;fontColor=#354961;align=left;verticalAlign=middle;spacingLeft=18;" parent="1" vertex="1"><mxGeometry x="70" y="1135" width="1660" height="55" as="geometry" /></mxCell><mxCell id="p4-note-bg" value="" style="rounded=1;html=1;fillColor=#F8FAFD;strokeColor=#C5D3E5;" parent="1" vertex="1"><mxGeometry x="70" y="995" width="1660" height="68" as="geometry" /></mxCell><mxCell id="p4-note-line-0" value="RECEPCION.estado: PENDIENTE, CONFIRMADA o RECHAZADA. Se permiten recepciones parciales." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFa