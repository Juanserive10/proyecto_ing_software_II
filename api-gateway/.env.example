APP_NAME="Andina API Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=info

# El gateway es stateless: no usa base de datos ni sesiones.
DB_CONNECTION=sqlite
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---- Gateway ----
JWT_SECRET=andina-jwt-super-secret-2026
# local (valida firma con JWT_SECRET) | remote (POST usuarios-service/auth/verify)
JWT_VERIFY_MODE=local
JWT_VERIFY_URL=http://usuarios-service:5001/auth/verify
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GATEWAY_UPSTREAM_TIMEOUT=30
GATEWAY_CONNECT_TIMEOUT=5

USUARIOS_SERVICE_URL=http://usuarios-service:5001
CATALOGO_SERVICE_URL=http://catalogo-service:5002
INVENTARIO_SERVICE_URL=http://inventario-service:5003
ABASTECIMIENTO_SERVICE_URL=http://abastecimiento-service:5004
VENTAS_SERVICE_URL=http://ventas-service:5005
REPORTES_SERVICE_URL=http://reportes-service:5006
